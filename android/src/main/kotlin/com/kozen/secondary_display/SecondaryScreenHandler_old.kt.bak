package com.example.kzplatco

import android.content.Context
import android.util.Log
import android.view.LayoutInflater
import android.view.View
import android.widget.TextView
import com.kozen.component_client.ComponentEngine
import com.kozen.component.secondaryScreen.IResultCallback
import io.flutter.plugin.common.MethodCall
import io.flutter.plugin.common.MethodChannel

class SecondaryScreenHandler(private val context: Context) {
    private val TAG = "SecondaryScreenHandler"
    private var gifAnimHandler: android.os.Handler? = null
    private var gifAnimRunnable: Runnable? = null

    init {
        initializeSDK()
    }

    private fun initializeSDK() {
        Log.d(TAG, "Initializing KOZEN Component SDK v1.3.0 (Permissive mode)...")
        ComponentEngine.init(context.applicationContext) { result, errorMsg ->
            if (result == 0) {
                Log.d(TAG, "SDK Initialized successfully")
            } else if (result == -10004) {
                Log.w(TAG, "SDK Version mismatch (1.3.0 vs 1.2.5), but trying to continue anyway...")
            } else {
                Log.e(TAG, "SDK Initialization failed: $result - $errorMsg")
            }
        }
    }

    fun handleMethodCall(call: MethodCall, result: MethodChannel.Result) {
        var manager = ComponentEngine.secondaryScreenManager
        
        if (manager == null) {
            Log.w(TAG, "Manager was null, trying to re-init...")
            initializeSDK()
            manager = ComponentEngine.secondaryScreenManager
        }

        if (manager == null) {
            Log.e(TAG, "Secondary Screen Manager still null after re-init attempt")
            result.error("NOT_INITIALIZED", "Secondary Screen SDK not initialized", null)
            return
        }

        when (call.method) {
            "getScreenResolution" -> {
                val res = manager.screenResolution
                if (res != null && res.size >= 2) {
                    result.success(mapOf("width" to res[0], "height" to res[1]))
                } else {
                    result.error("ERROR", "Could not get resolution", null)
                }
            }
            "power" -> {
                val on = call.argument<Boolean>("on") ?: true
                val status = manager.power(on)
                result.success(status == 0)
            }
            "setBrightness" -> {
                val value = call.argument<Int>("value") ?: 50
                val status = manager.setBrightness(value)
                result.success(status == 0)
            }
            "getBrightness" -> {
                val brightness = manager.brightness
                result.success(brightness)
            }
            "showPic" -> {
                val path = call.argument<String>("path")
                if (path != null) {
                    val status = manager.showPic(path)
                    result.success(status == 0)
                } else {
                    result.error("INVALID_ARGUMENT", "Path is null", null)
                }
            }
            "showVideo" -> {
                val path = call.argument<String>("path")
                Log.d(TAG, "showVideo called with path: $path")
                if (path != null) {
                    val status = manager.showVideo(path)
                    Log.d(TAG, "showVideo status: $status (0=success)")
                    result.success(status == 0)
                } else {
                    result.error("INVALID_ARGUMENT", "Path is null", null)
                }
            }
            "showWallpaper" -> {
                showWallpaper(result)
            }
            "getPowerOnStatus" -> {
                val status = manager.powerOnStatus
                result.success(status == 0) // 0 is Power ON according to docs
            }
            "showWelcome" -> {
                showWelcome(result)
            }
            "showAmount" -> {
                val amount = call.argument<String>("amount") ?: "0,00"
                val title = call.argument<String>("title") ?: ""
                val currency = call.argument<String>("currency") ?: ""
                showAmount(amount, title, currency, result)
            }
            "showStatus" -> {
                val title = call.argument<String>("title") ?: ""
                val subtitle = call.argument<String>("subtitle") ?: ""
                showStatus(title, subtitle, result)
            }
            "showReadCard" -> {
                showReadCard(result)
            }
            "showApproved" -> {
                showApproved(result)
            }
            "showRejected" -> {
                val message = call.argument<String>("message") ?: ""
                showRejected(message, result)
            }
            else -> result.notImplemented()
        }
    }

    fun showWallpaper(result: MethodChannel.Result? = null) {
        stopGifAnimation()
        val manager = ComponentEngine.secondaryScreenManager ?: run {
            result?.error("NOT_INITIALIZED", "Secondary Screen SDK not initialized", null)
            return
        }

        try {
            val inflater = LayoutInflater.from(context)
            val view = inflater.inflate(R.layout.secondary_wallpaper, null)

            // Get screen resolution for measurement
            val resolution = manager.screenResolution
            val widthPX = if (resolution != null && resolution.size >= 1) resolution[0] else 378
            val heightPX = if (resolution != null && resolution.size >= 2) resolution[1] else 172

            // Measure and layout
            val widthSpec = View.MeasureSpec.makeMeasureSpec(widthPX, View.MeasureSpec.EXACTLY)
            val heightSpec = View.MeasureSpec.makeMeasureSpec(heightPX, View.MeasureSpec.EXACTLY)
            view.measure(widthSpec, heightSpec)
            view.layout(0, 0, widthPX, heightPX)

            manager.show(view, object : IResultCallback {
                override fun onSuccess() {
                    Log.d(TAG, "Custom wallpaper view shown successfully")
                    result?.success(true)
                }

                override fun onFailure(errorCode: Int, errorMsg: String?) {
                    Log.e(TAG, "Failed to show custom wallpaper: $errorCode - $errorMsg")
                    // Fallback to system wallpaper
                    manager.showWallpaper()
                    result?.error(errorCode.toString(), errorMsg, null)
                }
            })
        } catch (e: Exception) {
            Log.e(TAG, "Error inflating or showing custom wallpaper", e)
            manager.showWallpaper() // Fallback
            result?.error("INFLATION_ERROR", e.message, null)
        }
    }

    private fun showWelcome(result: MethodChannel.Result) {
        stopGifAnimation()
        val manager = ComponentEngine.secondaryScreenManager ?: run {
            result.error("NOT_INITIALIZED", "Secondary Screen SDK not initialized", null)
            return
        }

        try {
            val inflater = LayoutInflater.from(context)
            val view = inflater.inflate(R.layout.secondary_welcome, null)

            // Get screen resolution for measurement
            val resolution = manager.screenResolution
            val widthPX = if (resolution != null && resolution.size >= 1) resolution[0] else 378
            val heightPX = if (resolution != null && resolution.size >= 2) resolution[1] else 172

            // Measure and layout as per sample project's Utils.layoutToView
            val widthSpec = View.MeasureSpec.makeMeasureSpec(widthPX, View.MeasureSpec.EXACTLY)
            val heightSpec = View.MeasureSpec.makeMeasureSpec(heightPX, View.MeasureSpec.EXACTLY)
            view.measure(widthSpec, heightSpec)
            view.layout(0, 0, widthPX, heightPX)

            manager.show(view, object : IResultCallback {
                override fun onSuccess() {
                    Log.d(TAG, "Custom welcome view shown successfully")
                    result.success(true)
                }

                override fun onFailure(errorCode: Int, errorMsg: String?) {
                    Log.e(TAG, "Failed to show custom view: $errorCode - $errorMsg")
                    result.error(errorCode.toString(), errorMsg, null)
                }
            })
        } catch (e: Exception) {
            Log.e(TAG, "Error inflating or showing welcome view", e)
            result.error("INFLATION_ERROR", e.message, null)
        }
    }

    private fun showAmount(amount: String, title: String, currency: String, result: MethodChannel.Result) {
        stopGifAnimation()
        val manager = ComponentEngine.secondaryScreenManager ?: run {
            result.error("NOT_INITIALIZED", "Secondary Screen SDK not initialized", null)
            return
        }

        try {
            val inflater = LayoutInflater.from(context)
            val view = inflater.inflate(R.layout.secondary_amount, null)
            val amountTv = view.findViewById<TextView>(R.id.amount_text)
            val titleTv = view.findViewById<TextView>(R.id.amount_title)
            val currencyTv = view.findViewById<TextView>(R.id.currency_text)

            amountTv.text = amount
            if (title.isNotEmpty()) {
                titleTv.text = title.toUpperCase()
            }

            if (currency.isNotEmpty()) {
                currencyTv.text = currency
                currencyTv.visibility = View.VISIBLE
            } else {
                currencyTv.visibility = View.GONE
            }

            // Get screen resolution for measurement
            val resolution = manager.screenResolution
            val widthPX = if (resolution != null && resolution.size >= 1) resolution[0] else 378
            val heightPX = if (resolution != null && resolution.size >= 2) resolution[1] else 172

            // Measure and layout
            val widthSpec = View.MeasureSpec.makeMeasureSpec(widthPX, View.MeasureSpec.EXACTLY)
            val heightSpec = View.MeasureSpec.makeMeasureSpec(heightPX, View.MeasureSpec.EXACTLY)
            view.measure(widthSpec, heightSpec)
            view.layout(0, 0, widthPX, heightPX)

            manager.show(view, object : IResultCallback {
                override fun onSuccess() {
                    Log.d(TAG, "Amount view shown successfully")
                    result.success(true)
                }

                override fun onFailure(errorCode: Int, errorMsg: String?) {
                    Log.e(TAG, "Failed to show amount view: $errorCode - $errorMsg")
                    result.error(errorCode.toString(), errorMsg, null)
                }
            })
        } catch (e: Exception) {
            Log.e(TAG, "Error inflating or showing amount view", e)
            result.error("INFLATION_ERROR", e.message, null)
        }
    }

