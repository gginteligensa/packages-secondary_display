        stopGifAnimation()
        val manager = ComponentEngine.secondaryScreenManager ?: run {
            result.error("NOT_INITIALIZED", "Secondary Screen SDK not initialized", null)
            return
        }

        try {
            val inflater = LayoutInflater.from(context)
            val view = inflater.inflate(R.layout.secondary_status, null)
            view.findViewById<TextView>(R.id.status_title).text = title
            view.findViewById<TextView>(R.id.status_subtitle).text = subtitle

            // Get screen resolution for measurement
            val resolution = manager.screenResolution
            val widthPX = if (resolution != null && resolution.size >= 1) resolution[0] else 378
            val heightPX = if (resolution != null && resolution.size >= 2) resolution[1] else 172

            // Measure and layout
            val widthSpec = View.MeasureSpec.makeMeasureSpec(widthPX, View.MeasureSpec.EXACTLY)
            val heightSpec = View.MeasureSpec.makeMeasureSpec(heightPX, View.MeasureSpec.EXACTLY)
            view.measure(widthSpec, heightSpec)
            view.layout(0, 0, widthPX, heightPX)

            manager.show(view, object : IResultCallback {
                override fun onSuccess() {
                    Log.d(TAG, "Status view shown successfully")
                    result.success(true)
                }

                override fun onFailure(errorCode: Int, errorMsg: String?) {
                    Log.e(TAG, "Failed to show status view: $errorCode - $errorMsg")
                    result.error(errorCode.toString(), errorMsg, null)
                }
            })
        } catch (e: Exception) {
            Log.e(TAG, "Error inflating or showing status view", e)
            result.error("INFLATION_ERROR", e.message, null)
        }
    }

    private fun stopGifAnimation() {
        gifAnimRunnable?.let { gifAnimHandler?.removeCallbacks(it) }
        gifAnimHandler = null
        gifAnimRunnable = null
    }

    private fun showReadCard(result: MethodChannel.Result) {
        val manager = ComponentEngine.secondaryScreenManager ?: run {
            result.error("NOT_INITIALIZED", "Secondary Screen SDK not initialized", null)
            return
        }

        val resolution = manager.screenResolution
        val widthPX = if (resolution != null && resolution.size >= 1) resolution[0] else 378
        val heightPX = if (resolution != null && resolution.size >= 2) resolution[1] else 172

        android.os.Handler(android.os.Looper.getMainLooper()).post {
            try {
                // Stop any existing animation
                stopGifAnimation()

                // Decode GIF using Movie API
                val inputStream = context.resources.openRawResource(R.raw.read_card_gif)
                @Suppress("DEPRECATION")
                val movie = android.graphics.Movie.decodeStream(inputStream)
                inputStream.close()

                if (movie == null || movie.width() == 0) {
                    Log.e(TAG, "Failed to decode GIF via Movie API")
                    result.error("DECODE_ERROR", "Could not decode GIF", null)
                    return@post
                }

                Log.d(TAG, "GIF decoded: ${movie.width()}x${movie.height()}, duration=${movie.duration()}ms")

                val duration = movie.duration().coerceAtLeast(1)
                val frameIntervalMs = 50L // ~20fps
                val startTime = System.currentTimeMillis()

                val inflater = LayoutInflater.from(context)
                val view = inflater.inflate(R.layout.secondary_read_card, null)
                val imageView = view.findViewById<android.widget.ImageView>(R.id.read_card_gif)

                val widthSpec = View.MeasureSpec.makeMeasureSpec(widthPX, View.MeasureSpec.EXACTLY)
                val heightSpec = View.MeasureSpec.makeMeasureSpec(heightPX, View.MeasureSpec.EXACTLY)

                var firstFrame = true
                val handler = android.os.Handler(android.os.Looper.getMainLooper())
                gifAnimHandler = handler

                val runnable = object : Runnable {
                    override fun run() {
                        val elapsed = ((System.currentTimeMillis() - startTime) % duration).toInt()
                        movie.setTime(elapsed)

                        val bitmap = android.graphics.Bitmap.createBitmap(
                            widthPX, heightPX, android.graphics.Bitmap.Config.ARGB_8888
                        )
                        val canvas = android.graphics.Canvas(bitmap)
                        val scaleX = widthPX.toFloat() / movie.width()
                        val scaleY = heightPX.toFloat() / movie.height()
                        canvas.scale(scaleX, scaleY)
                        movie.draw(canvas, 0f, 0f)

                        imageView.setImageBitmap(bitmap)
                        view.measure(widthSpec, heightSpec)
                        view.layout(0, 0, widthPX, heightPX)

                        if (firstFrame) {
                            firstFrame = false
                            manager.show(view, object : IResultCallback {
                                override fun onSuccess() {
                                    Log.d(TAG, "✅ showReadCard first frame shown")
                                    result.success(true)
                                }
                                override fun onFailure(errorCode: Int, errorMsg: String?) {
                                    Log.e(TAG, "❌ showReadCard failed: $errorCode - $errorMsg")
                                    stopGifAnimation()
                                    result.error(errorCode.toString(), errorMsg, null)
                                }
                            })
                        } else {
                            // Subsequent frames: fire-and-forget (no result callback needed)
                            manager.show(view, object : IResultCallback {
                                override fun onSuccess() {}
                                override fun onFailure(errorCode: Int, errorMsg: String?) {
                                    Log.w(TAG, "Frame show failed: $errorCode")
                                }
                            })
                        }

                        handler.postDelayed(this, frameIntervalMs)
                    }
                }
                gifAnimRunnable = runnable
                handler.post(runnable)

            } catch (e: Exception) {
                Log.e(TAG, "Error in showReadCard: ${e.message}", e)
                result.error("SHOW_ERROR", e.message, null)
            }
        }
    }

    // ─── Helper: draw a result frame to a Bitmap ────────────────────────────────

    private fun drawResultBitmap(
        w: Int, h: Int,
        bgColorTop: Int, bgColorBottom: Int,
        iconProgress: Float, // 0.0 → 1.0: how much of the icon is drawn
        iconColor: Int,
        isApproved: Boolean,
        labelText: String,
        subText: String = ""
    ): android.graphics.Bitmap {
        val bmp = android.graphics.Bitmap.createBitmap(w, h, android.graphics.Bitmap.Config.ARGB_8888)
        val canvas = android.graphics.Canvas(bmp)

        // Background gradient
        val gradient = android.graphics.LinearGradient(
            0f, 0f, 0f, h.toFloat(),
            bgColorTop, bgColorBottom,
            android.graphics.Shader.TileMode.CLAMP
        )
        val bgPaint = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG)
        bgPaint.shader = gradient
        canvas.drawRect(0f, 0f, w.toFloat(), h.toFloat(), bgPaint)

        // Icon circle background (semi-transparent white)
        val cx = w * 0.25f
        val cy = h * 0.5f
        val circleR = h * 0.25f
        val circlePaint = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG)
        circlePaint.color = 0x33FFFFFF
        canvas.drawCircle(cx, cy, circleR, circlePaint)

        // Icon stroke paint
        val iconPaint = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG)
        iconPaint.color = iconColor
        iconPaint.style = android.graphics.Paint.Style.STROKE
        iconPaint.strokeWidth = h * 0.07f
        iconPaint.strokeCap = android.graphics.Paint.Cap.ROUND
        iconPaint.strokeJoin = android.graphics.Paint.Join.ROUND

        if (isApproved) {
            // Draw ✓ checkmark progressively
            // Path: (cx-r*0.45, cy) → (cx-r*0.1, cy+r*0.4) → (cx+r*0.5, cy-r*0.4)
            val p1x = cx - circleR * 0.45f; val p1y = cy
            val p2x = cx - circleR * 0.1f;  val p2y = cy + circleR * 0.4f
            val p3x = cx + circleR * 0.5f;  val p3y = cy - circleR * 0.4f

            val seg1Len = Math.hypot((p2x - p1x).toDouble(), (p2y - p1y).toDouble()).toFloat()
            val seg2Len = Math.hypot((p3x - p2x).toDouble(), (p3y - p2y).toDouble()).toFloat()
            val totalLen = seg1Len + seg2Len
            val drawnLen = totalLen * iconProgress

            if (drawnLen <= seg1Len) {
                val t = drawnLen / seg1Len
                canvas.drawLine(p1x, p1y, p1x + (p2x - p1x) * t, p1y + (p2y - p1y) * t, iconPaint)
            } else {
                canvas.drawLine(p1x, p1y, p2x, p2y, iconPaint)
                val t = (drawnLen - seg1Len) / seg2Len
                canvas.drawLine(p2x, p2y, p2x + (p3x - p2x) * t, p2y + (p3y - p2y) * t, iconPaint)
            }
        } else {
            // Draw ✗ cross progressively
            val r = circleR * 0.5f
            val line1x1 = cx - r; val line1y1 = cy - r
            val line1x2 = cx + r; val line1y2 = cy + r
            val line2x1 = cx + r; val line2y1 = cy - r
            val line2x2 = cx - r; val line2y2 = cy + r

            if (iconProgress <= 0.5f) {
                val t = iconProgress / 0.5f
                canvas.drawLine(line1x1, line1y1, line1x1 + (line1x2 - line1x1) * t, line1y1 + (line1y2 - line1y1) * t, iconPaint)
            } else {
                canvas.drawLine(line1x1, line1y1, line1x2, line1y2, iconPaint)
                val t = (iconProgress - 0.5f) / 0.5f
                canvas.drawLine(line2x1, line2y1, line2x1 + (line2x2 - line2x1) * t, line2y1 + (line2y2 - line2y1) * t, iconPaint)
            }
        }

        // Label text (right side)
        val textPaint = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG)
        textPaint.color = android.graphics.Color.WHITE
        textPaint.typeface = android.graphics.Typeface.create(android.graphics.Typeface.DEFAULT_BOLD, android.graphics.Typeface.BOLD)
        textPaint.textSize = h * 0.18f
        textPaint.letterSpacing = 0.05f

        val textX = w * 0.42f
        val textY = if (subText.isEmpty()) h * 0.57f else h * 0.42f
        canvas.drawText(labelText, textX, textY, textPaint)

        // Sub text (response message)
        if (subText.isNotEmpty()) {
            val subPaint = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG)
            subPaint.color = 0xCCFFFFFF.toInt()
            subPaint.typeface = android.graphics.Typeface.DEFAULT
            subPaint.textSize = h * 0.11f
            val subTruncated = if (subText.length > 22) subText.substring(0, 22) else subText
            canvas.drawText(subTruncated.uppercase(), textX, h * 0.68f, subPaint)
        }

        return bmp
    }

    private fun animateResultScreen(
        isApproved: Boolean,
        bgColorTop: Int, bgColorBottom: Int,
        iconColor: Int,
        labelText: String,
        subText: String,
        result: MethodChannel.Result
    ) {
        val manager = ComponentEngine.secondaryScreenManager ?: run {
            result.error("NOT_INITIALIZED", "Secondary Screen SDK not initialized", null)
            return
        }

        val resolution = manager.screenResolution
        val w = if (resolution != null && resolution.size >= 1) resolution[0] else 378
        val h = if (resolution != null && resolution.size >= 2) resolution[1] else 172

        android.os.Handler(android.os.Looper.getMainLooper()).post {
            stopGifAnimation()

            val totalFrames = 16    // animation phase
            val holdFrames = 40     // hold static at end
            var frame = 0
            var resultSent = false

            val inflater = LayoutInflater.from(context)
            val view = inflater.inflate(R.layout.secondary_read_card, null) // reuse simple layout
            val imageView = view.findViewById<android.widget.ImageView>(R.id.read_card_gif)

            val widthSpec  = View.MeasureSpec.makeMeasureSpec(w, View.MeasureSpec.EXACTLY)
            val heightSpec = View.MeasureSpec.makeMeasureSpec(h, View.MeasureSpec.EXACTLY)

            val handler = android.os.Handler(android.os.Looper.getMainLooper())
            gifAnimHandler = handler

            val runnable = object : Runnable {
                override fun run() {
                    val progress = if (frame < totalFrames) {
                        // Ease-out: progress goes from 0 to 1
                        val t = frame.toFloat() / totalFrames
                        1f - (1f - t) * (1f - t)
                    } else 1f

                    val bmp = drawResultBitmap(w, h, bgColorTop, bgColorBottom, progress, iconColor, isApproved, labelText, subText)
                    imageView.setImageBitmap(bmp)
                    view.measure(widthSpec, heightSpec)
                    view.layout(0, 0, w, h)

                    val isLast = frame >= totalFrames + holdFrames

                    manager.show(view, object : IResultCallback {
                        override fun onSuccess() {
                            if (!resultSent) {
                                resultSent = true
                                result.success(true)
                            }
                        }
                        override fun onFailure(errorCode: Int, errorMsg: String?) {
                            if (!resultSent) {
                                resultSent = true
                                result.error(errorCode.toString(), errorMsg, null)
                            }
                        }
                    })

                    frame++
                    if (!isLast) {
                        handler.postDelayed(this, 40L) // ~25fps
                    } else {
                        gifAnimHandler = null
                        gifAnimRunnable = null
                    }
                }
            }
            gifAnimRunnable = runnable
            handler.post(runnable)
        }
    }

    private fun showApproved(result: MethodChannel.Result) {
        Log.d(TAG, "showApproved called")
        animateResultScreen(
            isApproved    = true,
            bgColorTop    = 0xFF00C853.toInt(),
            bgColorBottom = 0xFF1B5E20.toInt(),
            iconColor     = android.graphics.Color.WHITE,
            labelText     = "APROBADO",
            subText       = "",
            result        = result
        )
    }

    private fun showRejected(message: String, result: MethodChannel.Result) {
        Log.d(TAG, "showRejected called with message: $message")
        animateResultScreen(
            isApproved    = false,
            bgColorTop    = 0xFFD32F2F.toInt(),
            bgColorBottom = 0xFF7F0000.toInt(),
            iconColor     = android.graphics.Color.WHITE,
            labelText     = "DENEGADO",
            subText       = message,
            result        = result
        )
    }

    fun deInit() {
        // In 1.3.0 deInit might not be available or needed as it was in older docs
        // ComponentEngine.deInit() 
    }
}
